 export PROJECT_ID="cloud-tpu-best-effort-colo"
 export NUM_REPLICAS=${NUM_REPLICAS:-32}
-export JOBSET_NAME=${JOBSET_NAME:-$USER-long-run-$NUM_REPLICAS-$(date +%Y%m%d-%H%M)}
